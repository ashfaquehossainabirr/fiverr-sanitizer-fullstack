# MongoDB connection string (local or Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/fiverr_sanitizer

# Secret used to sign JWT auth tokens - change this to a long random string
JWT_SECRET=replace_this_with_a_long_random_secret

# How long a login session stays valid
JWT_EXPIRES_IN=7d

# Port the API server listens on
PORT=5000

# Comma-separated list of allowed frontend origins
CLIENT_ORIGIN=http://localhost:5173

# Google OAuth Client ID (from Google Cloud Console > APIs & Services >
# Credentials). Required for "Sign in with Google" / "Register with Google".
# Must be the same Client ID configured in the client's VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Used only by `npm run seed:admin` to create/promote the first admin account
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_strong_password
ADMIN_NAME=Admin
