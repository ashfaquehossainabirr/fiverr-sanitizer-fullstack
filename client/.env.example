# URL of the deployed backend API, including the /api prefix.
# Required in production when the frontend and backend are on different
# domains (e.g. frontend on Vercel, backend on Render).
# Leave unset for local dev — Vite's dev proxy handles /api automatically.
VITE_API_URL=https://your-backend.onrender.com/api

# Google OAuth Client ID (same value as the server's GOOGLE_CLIENT_ID).
# Used to render the "Continue with Google" button on Login/Register.
# If left unset, the Google button simply won't be shown.
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
